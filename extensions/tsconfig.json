{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".build",
    "rootDir": "shared/src",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["shared/src/**/*.ts"],
  "exclude": ["shared/src/**/*.test.ts"]
}
