{
  "manifest_version": 3,
  "name": "GrabBit Browser Integration",
  "version": "0.2.0",
  "description": "Send authorized HTTP/HTTPS downloads and media pages to GrabBit.",
  "key": "",
  "permissions": ["nativeMessaging", "downloads", "contextMenus", "storage", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "GrabBit" },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
