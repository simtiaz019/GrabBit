{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrabBit",
  "version": "0.1.0",
  "identifier": "com.grabbit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run extension:build && node scripts/prepare-browser-host.mjs && node scripts/prepare-media-tools.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GrabBit — Download Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../target/browser-native-host-resources/grabbit-browser-host*": "browser-native-host/",
      "../target/media-tools-resources/yt-dlp*": "media-tools/",
      "../target/media-tools-resources/ffmpeg*": "media-tools/",
      "../target/media-tools-resources/ffprobe*": "media-tools/",
      "../target/media-tools-resources/THIRD_PARTY_NOTICES.txt": "media-tools/THIRD_PARTY_NOTICES.txt",
      "../target/media-tools-resources/licenses/*": "media-tools/licenses/",
      "../extensions/chromium/dist/*": "browser-extensions/chromium/",
      "../extensions/firefox/dist/*": "browser-extensions/firefox/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "GrabBit",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "../packaging/windows/installer-hooks.nsh"
      }
    }
  }
}
